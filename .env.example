# Supabase PostgreSQL 연결 문자열
# Supabase 대시보드 → Settings → Database → Connection string (URI) 에서 복사
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Supabase 프로젝트 URL
# Supabase 대시보드 → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co

# Supabase Service Role Key (서버 전용 — 절대 클라이언트에 노출 금지)
# Supabase 대시보드 → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Google AI Studio API Key (이미지 생성 PoC용)
# https://aistudio.google.com 에서 발급 (무료 티어, 카드 등록 불필요) 후 .env.local 에 추가
GOOGLE_GENERATIVE_AI_API_KEY=
